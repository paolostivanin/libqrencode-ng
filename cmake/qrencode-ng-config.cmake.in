@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Only a static libqrencode-ng carries $<LINK_ONLY:Threads::Threads>.
if(@QRENCODE_NG_STATIC_NEEDS_THREADS@)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/qrencode-ng-targets.cmake")

check_required_components(qrencode-ng)
